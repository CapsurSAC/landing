# ─────────────────────────────────────────────────────────────
#  Variables del frontend — CAPSUR
#  Copia este archivo como .env en la raíz y rellena lo que uses.
#  Todo lo que empieza por VITE_ acaba dentro del JavaScript público:
#  aquí NUNCA van contraseñas ni claves privadas.
# ─────────────────────────────────────────────────────────────

# Adónde se envía el formulario. Por defecto, el PHP propio del mismo dominio.
#   PHP propio (server/):             /api/enviar.php
#   Formspree (sin servidor propio):  https://formspree.io/f/xxxxxxxx
VITE_FORM_ENDPOINT=/api/enviar.php

# WhatsApp de atención, solo dígitos con código de país (51 = Perú).
# Si se deja vacío, no aparece el botón de WhatsApp tras enviar.
# 51938230986 es el número de la bandeja Grupo CAPSUR.
VITE_WHATSAPP_NUMERO=51938230986

# Medición. Vacíos = no se carga nada.
VITE_META_PIXEL_ID=
VITE_GA4_ID=

# URL pública del sitio, sin barra final. Se usa para que la imagen de
# vista previa (og:image) sea absoluta, como exigen WhatsApp y Facebook.
VITE_URL_SITIO=
