// Esquema de datos de promotions-service.
// Catálogo comercial: marcas, especialidades, campañas y promociones.
// El cliente se genera en ./generated/client (ignorado por git) para que
// ningún otro servicio comparta el mismo cliente generado.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Línea formativa de una especialidad.
enum SpecialtyTrack {
  IA
  TRADICIONAL
}

/// Icono que la landing muestra en la tarjeta de la promoción.
enum PromotionIcon {
  GIFT
  LAYERS
  STACK
}

/// Marca comercial del grupo (hoy solo "sis").
model Brand {
  id          String   @id
  name        String
  displayName String   @map("display_name")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  specialties Specialty[]
  campaigns   Campaign[]
  promotions  Promotion[]

  @@map("brands")
}

/// Especialidad o carrera que ofrece la marca.
model Specialty {
  id         String         @id
  brandId    String         @map("brand_id")
  name       String
  shortName  String?        @map("short_name")
  track      SpecialtyTrack
  summary    String
  audience   String[]       @default([])
  modality   String         @default("100% virtual")
  endorsedBy String?        @map("endorsed_by")
  sortOrder  Int            @default(0) @map("sort_order")
  active     Boolean        @default(true)

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId, active])
  @@index([brandId, track])
  @@map("specialties")
}

/// Campaña comercial a la que se asocian las promociones.
model Campaign {
  id          String    @id
  brandId     String    @map("brand_id")
  name        String
  utmCampaign String?   @map("utm_campaign")
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  active      Boolean   @default(true)

  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  promotions Promotion[]

  @@index([brandId, active])
  @@map("campaigns")
}

/// Promoción con precio y vigencia. Es la autoridad sobre precios.
model Promotion {
  id                  String           @id
  brandId             String           @map("brand_id")
  name                String
  headline            String
  /// Precio en céntimos de la moneda indicada.
  priceAmount         Int              @map("price_amount")
  currency            String           @default("PEN")
  /// Precio de referencia tachado, en céntimos.
  listPriceAmount     Int?             @map("list_price_amount")
  specialtiesIncluded Int              @map("specialties_included")
  allowedTracks       SpecialtyTrack[] @map("allowed_tracks")
  bundleLabel         String           @map("bundle_label")
  featured            Boolean          @default(false)
  icon                PromotionIcon    @default(LAYERS)
  validFrom           DateTime         @map("valid_from")
  validUntil          DateTime?        @map("valid_until")
  campaignId          String?          @map("campaign_id")
  sortOrder           Int              @default(0) @map("sort_order")
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([brandId, active])
  @@index([validFrom, validUntil])
  @@map("promotions")
}

/// Registro de auditoría de las acciones internas (C24): quién (servicio y
/// persona) hizo qué y sobre qué recurso. Nunca guarda cuerpos de petición.
model AuditLog {
  id       String   @id @db.Uuid
  at       DateTime @db.Timestamptz(3)
  caller   String
  actor    String?
  action   String
  target   String?
  metadata Json?

  @@index([at(sort: Desc)])
  @@map("audit_log")
}
