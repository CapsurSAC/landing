# ---------------------------------------------------------------------------
# ACL de Redis de PRODUCCIÓN (C22). PLANTILLA: start-redis.sh sustituye cada
# __<VAR>_SHA256__ por el SHA-256 de la contraseña de la variable <VAR> y
# escribe el resultado en /tmp (tmpfs). Nunca hay contraseñas en claro en disco.
#
# Reglas:
#   - `default` desactivado: toda conexión debe autenticarse con usuario.
#   - Cada servicio solo ve su prefijo de claves (~<svc>:*) y de canales.
#   - Sin comandos peligrosos/administrativos (FLUSH*, CONFIG, KEYS, DEBUG,
#     MONITOR, SHUTDOWN, ACL, MODULE...). Se permite INFO (lo usa el ready
#     check de ioredis) y PING.
#   - Los servicios configuran ioredis con keyPrefix "<svc>:".
# ---------------------------------------------------------------------------
user default off resetkeys resetchannels -@all

user promotions_svc on #__PROMOTIONS_REDIS_PASSWORD_SHA256__ resetkeys ~promotions:* resetchannels &promotions:* -@all +@read +@write +@string +@hash +@list +@set +@sortedset +@keyspace +@scripting +@connection +@transaction -@dangerous -@admin +info +ping

user leads_svc on #__LEADS_REDIS_PASSWORD_SHA256__ resetkeys ~leads:* resetchannels &leads:* -@all +@read +@write +@string +@hash +@list +@set +@sortedset +@keyspace +@scripting +@connection +@transaction -@dangerous -@admin +info +ping

# Healthcheck del contenedor: solo PING.
user healthcheck on #__REDIS_HEALTHCHECK_PASSWORD_SHA256__ resetkeys resetchannels -@all +ping

# Operación (diagnóstico). Acceso total; usar solo con `docker compose exec`.
user ops_admin on #__REDIS_ADMIN_PASSWORD_SHA256__ ~* &* +@all
