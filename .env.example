# landing-sis (Next.js). Copia este archivo a .env y ajusta los valores.

# WhatsApp que recibe solicitudes, reclamos y ARCO (E.164 sin "+").
NEXT_PUBLIC_WHATSAPP_NUMBER=51987867402
NEXT_PUBLIC_PRIVACY_POLICY_VERSION=2026-11
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Casilla opcional de autorización publicitaria (0/1) y enlaces de redes
NEXT_PUBLIC_SHOW_MARKETING_CONSENT=0
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/ISTPSistemasDelSur
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/istp_sistemasdelsur/
NEXT_PUBLIC_SOCIAL_TIKTOK=https://www.tiktok.com/@istp.sistemasdelsur
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/istp-sistemas-del-sur-81bb81355
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@institutosis6394
# Sentry. Vacío = desactivado. Sin PII y sin subida de sourcemaps.
NEXT_PUBLIC_SENTRY_DSN=
# Experimentos A/B del hero: true/false
NEXT_PUBLIC_EXPERIMENTS_ENABLED=true

# Panel /admin. Hash y secreto: node scripts/hash-password.mjs "tu-contraseña"
ADMIN_USER=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Carpeta del archivo SQLite con los leads (en producción, un disco persistente)
DATA_DIR=./data
