# ---------------------------------------------------------------------------
# Variables de entorno de referencia (DESARROLLO LOCAL), agrupadas por servicio.
#   - Copia a .env (raíz) para docker compose: `cp .env.example .env`.
#   - Cada app tiene además apps/<app>/.env.example (lo que lee en `pnpm dev`),
#     generado desde su esquema de @capsur/config.
#   - Los valores dev-* y las claves PII de abajo son los de desarrollo
#     documentados en docs/architecture/v2-integration-spec.md: NUNCA en producción.
#   - Producción: infrastructure/docker/prod.env.example y docs/security/secrets.md.
# ---------------------------------------------------------------------------

# ============================ Infraestructura ==============================
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=postgres
PROMOTIONS_DB_PASSWORD=promotions
LEADS_DB_PASSWORD=leads
CRM_BRIDGE_DB_PASSWORD=crm_bridge
REDIS_URL=redis://localhost:6379
# RabbitMQ: `capsur` solo para el panel (http://localhost:15672). Los servicios usan su propio usuario (C21).
RABBITMQ_USER=capsur
RABBITMQ_PASSWORD=capsur
LEADS_RABBITMQ_PASSWORD=leads_svc_local
CRM_BRIDGE_RABBITMQ_PASSWORD=crm_bridge_svc_local
# URLs desde el host (pnpm dev): amqp://leads_svc:leads_svc_local@localhost:5672 y
# amqp://crm_bridge_svc:crm_bridge_svc_local@localhost:5672 (van en apps/<svc>/.env)

# Gateway (Traefik, :8080). Panel en host propio; allowlist opcional (CIDR separados por comas).
ADMIN_HOST=admin.localhost
ADMIN_IP_ALLOWLIST=

# Puertos locales
WEB_PORT=3000
PROMOTIONS_PORT=3001
LEADS_PORT=3002
CRM_BRIDGE_PORT=3003
ADMIN_PORT=3004

# ============================ Comunes (@capsur/config) =====================
NODE_ENV=development
LOG_LEVEL=info
# Swagger en /internal/docs: en producción desactivado salvo true (y aun así con token).
SWAGGER_ENABLED=false
SENTRY_ENVIRONMENT=local
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Cifrado y hash de datos personales (AES-256-GCM / HMAC-SHA256), 32 bytes en base64.
PII_ENCRYPTION_KEY=ZGV2LW9ubHktcGlpLWtleS0zMi1ieXRlcy1sb25nISE=
PII_HASH_KEY=ZGV2LW9ubHktaGFzaC1rZXktMzItYnl0ZXMtbG9uZyEhIQ==

# ============================ promotions-service (:3001) ===================
PROMOTIONS_DATABASE_URL=postgresql://promotions:promotions@localhost:5432/promotions?schema=public
PROMOTIONS_INTERNAL_API_TOKENS={"admin-web":"dev-admin-to-promotions","leads-service":"dev-leads-to-promotions"}
CATALOG_CACHE_TTL_SECONDS=60
# Revalidación del catálogo en web-sis tras cambios del panel (B8)
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
WEB_REVALIDATE_SECRET=dev-revalidate-secret
PROMOTIONS_SENTRY_DSN=

# ============================ leads-service (:3002) ========================
LEADS_DATABASE_URL=postgresql://leads:leads@localhost:5432/leads?schema=public
LEADS_INTERNAL_API_TOKENS={"admin-web":"dev-admin-to-leads"}
PROMOTIONS_SERVICE_URL=http://localhost:3001
LEADS_PROMOTIONS_SERVICE_TOKEN=dev-leads-to-promotions
REFERENCE_PREFIX=SIS
OUTBOX_POLL_INTERVAL_MS=2000
LEADS_RATE_LIMIT_PER_MINUTE=10
IP_HASH_PEPPER=cambia-esta-pimienta-en-produccion
# Token de estado del lead: HMAC-SHA256(LEAD_TOKEN_SECRET, leadId) (C18)
LEAD_TOKEN_SECRET=dev-only-lead-token-secret-change-me
# Retención: anonimización automática tras N días (C9)
LEAD_RETENTION_DAYS=730
# Feriados nacionales (YYYY-MM-DD, separados por comas) para plazos en días hábiles
PERU_HOLIDAYS=
# Turnstile (C3): vacío = no se exige token
TURNSTILE_SECRET_KEY=
# Correo de confirmación (A7): vacío = desactivado. Ej.: smtp://usuario:clave@smtp.example.com:587
SMTP_URL=
MAIL_FROM=Sistemas del Sur <no-reply@example.com>
LEADS_SENTRY_DSN=

# ============================ crm-bridge-service (:3003) ===================
CRM_BRIDGE_DATABASE_URL=postgresql://crm_bridge:crm_bridge@localhost:5432/crm_bridge?schema=public
# Reemplaza a la antigua INTERNAL_API_TOKEN: el reproceso manual usa el llamador `ops`.
CRM_BRIDGE_INTERNAL_API_TOKENS={"admin-web":"dev-admin-to-crm","ops":"dev-ops-to-crm"}
# Chatwoot (valores reales solo en el servidor; verificar cuenta/bandejas SIS antes de producción)
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_BASE_URL_ALLOWLIST=chatwoot.example.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_INBOX_ID_BY_CAMPUS={"tacna":1}
CHATWOOT_API_ACCESS_TOKEN=change-me
CHATWOOT_WEBHOOK_SECRET=change-me
CHATWOOT_WEBHOOK_SECRET_PREVIOUS=
WEBHOOK_IP_ALLOWLIST=
ASSIGNMENT_STRATEGY=round_robin
CHATWOOT_AUTO_REPLY_ENABLED=false
CATALOG_URLS_JSON={}
MAX_SYNC_ATTEMPTS=5
# Seguimiento por plantilla de WhatsApp si no escribió tras N horas (A6)
WHATSAPP_FOLLOWUP_ENABLED=false
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=
WHATSAPP_FOLLOWUP_TEMPLATE_LANGUAGE=es
WHATSAPP_FOLLOWUP_AFTER_HOURS=24
# Meta Conversions API (A17): vacío = desactivado; solo con consentimiento de marketing
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
CRM_BRIDGE_SENTRY_DSN=

# ============================ web-sis (:3000) ==============================
LEADS_SERVICE_URL=http://localhost:3002
# Debe coincidir con WEB_REVALIDATE_SECRET de promotions-service
REVALIDATE_SECRET=dev-revalidate-secret
# Variables públicas (se incrustan en el navegador en el build)
# Base de la API para el navegador. Vacío = mismo origen (recomendado detrás del gateway).
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp de captación SIS (E.164 sin "+")
NEXT_PUBLIC_WHATSAPP_NUMBER=51987867402
NEXT_PUBLIC_PRIVACY_POLICY_VERSION=2026-11
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
# Experimentos A/B en la landing (A18)
NEXT_PUBLIC_EXPERIMENTS_ENABLED=true
WEB_SENTRY_DSN=

# ============================ admin-web (:3004) ============================
CRM_BRIDGE_SERVICE_URL=http://localhost:3003
ADMIN_PROMOTIONS_SERVICE_TOKEN=dev-admin-to-promotions
ADMIN_LEADS_SERVICE_TOKEN=dev-admin-to-leads
ADMIN_CRM_BRIDGE_SERVICE_TOKEN=dev-admin-to-crm
# Firma de la sesión del panel (>= 32 caracteres)
ADMIN_SESSION_SECRET=dev-only-admin-session-secret-change-me-32b
# [{"email":"...","name":"...","role":"...","passwordHash":"$2b$..."}] — pnpm --filter @capsur/admin-web hash-password
ADMIN_USERS_JSON=[]
# En local (http) la cookie no puede ser Secure
ADMIN_COOKIE_SECURE=false
ADMIN_SENTRY_DSN=

# ============================ Pruebas de carga (k6) ========================
# pnpm load:leads  (BASE_URL desde el contenedor de k6: host.docker.internal)
BASE_URL=http://host.docker.internal:8080
RATE=50
DURATION=2m
