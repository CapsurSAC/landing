# ---------------------------------------------------------------------------
# Variables de docker-compose.prod.yml. PLANTILLA: todos los valores son de
# ejemplo y NO sirven en producción. Cópiala FUERA del repositorio
# (p. ej. /srv/capsur/prod.env, chmod 600) o carga los valores desde el gestor
# de secretos (docs/security/secrets.md).
#   Generar secretos:   openssl rand -hex 32      (contraseñas, tokens)
#                       openssl rand -base64 32   (PII_ENCRYPTION_KEY, PII_HASH_KEY)
#   Clave de backups:   age-keygen -o backup.key  (guardar la privada FUERA del servidor)
# Las contraseñas que van dentro de URLs deben ser hex/base64url (sin @ : / ?).
# Variables "opcionales" deben existir aunque estén vacías (vacío = desactivado).
# ---------------------------------------------------------------------------

# Dominios y certificados
PUBLIC_HOST=sis.example.com
ADMIN_HOST=admin.sis.example.com
# CIDR separados por comas (oficinas/VPN). Vacío = sin restricción por IP.
ADMIN_IP_ALLOWLIST=203.0.113.0/24
ACME_EMAIL=ops@example.com
IMAGE_TAG=prod

# PostgreSQL (superusuario solo para mantenimiento; nunca lo usan los servicios)
POSTGRES_SUPERPASSWORD=ejemplo-cambiar-superusuario
POSTGRES_TLS_DIR=/srv/capsur/postgres-tls
PROMOTIONS_MIGRATOR_DB_PASSWORD=ejemplo-cambiar-pm
PROMOTIONS_APP_DB_PASSWORD=ejemplo-cambiar-pa
LEADS_MIGRATOR_DB_PASSWORD=ejemplo-cambiar-lm
LEADS_APP_DB_PASSWORD=ejemplo-cambiar-la
CRM_BRIDGE_MIGRATOR_DB_PASSWORD=ejemplo-cambiar-cm
CRM_BRIDGE_APP_DB_PASSWORD=ejemplo-cambiar-ca
PGBOUNCER_AUTH_PASSWORD=ejemplo-cambiar-pgbouncer
BACKUP_DB_PASSWORD=ejemplo-cambiar-backup
# Clave PÚBLICA age (age1...). La privada se guarda offline (bóveda del gestor).
BACKUP_AGE_RECIPIENT=age1ejemploejemploejemploejemploejemploejemploejemploejemplo

# Redis (ACL por servicio)
PROMOTIONS_REDIS_PASSWORD=ejemplo-cambiar-redis-promotions
LEADS_REDIS_PASSWORD=ejemplo-cambiar-redis-leads
REDIS_HEALTHCHECK_PASSWORD=ejemplo-cambiar-redis-health
REDIS_ADMIN_PASSWORD=ejemplo-cambiar-redis-admin

# RabbitMQ (administrador solo para el panel; usuarios por servicio)
RABBITMQ_ADMIN_USER=capsur_admin
RABBITMQ_ADMIN_PASSWORD=ejemplo-cambiar-rabbit-admin
RABBITMQ_ERLANG_COOKIE=ejemplo-cambiar-cookie-erlang
LEADS_RABBITMQ_PASSWORD=ejemplo-cambiar-rabbit-leads
CRM_BRIDGE_RABBITMQ_PASSWORD=ejemplo-cambiar-rabbit-crm

# Autenticación entre servicios (§2 de la spec): JSON {"<llamador>":"<token>"}
PROMOTIONS_INTERNAL_API_TOKENS={"admin-web":"ejemplo-admin-promotions","leads-service":"ejemplo-leads-promotions"}
LEADS_INTERNAL_API_TOKENS={"admin-web":"ejemplo-admin-leads"}
CRM_BRIDGE_INTERNAL_API_TOKENS={"admin-web":"ejemplo-admin-crm","ops":"ejemplo-ops-crm"}
LEADS_PROMOTIONS_SERVICE_TOKEN=ejemplo-leads-promotions
ADMIN_PROMOTIONS_SERVICE_TOKEN=ejemplo-admin-promotions
ADMIN_LEADS_SERVICE_TOKEN=ejemplo-admin-leads
ADMIN_CRM_BRIDGE_SERVICE_TOKEN=ejemplo-admin-crm

# Datos personales (C8, C18, C19)
PII_ENCRYPTION_KEY=ZWplbXBsby1uby11c2FyLWVuLXByb2R1Y2Npb24tMzJi
PII_HASH_KEY=ZWplbXBsby1oYXNoLW5vLXVzYXItZW4tcHJvZHVjY2lvbg==
LEAD_TOKEN_SECRET=ejemplo-cambiar-lead-token
IP_HASH_PEPPER=ejemplo-cambiar-pimienta
PERU_HOLIDAYS=2026-12-08,2026-12-09,2026-12-25

# Web y panel
WHATSAPP_NUMBER=51987867402
NEXT_PUBLIC_PRIVACY_POLICY_VERSION=2026-11
REVALIDATE_SECRET=ejemplo-cambiar-revalidate
ADMIN_SESSION_SECRET=ejemplo-cambiar-sesion-admin-de-al-menos-32-caracteres
# [{"email":"...","name":"...","role":"admin|editor|viewer","passwordHash":"$2b$..."}]  (pnpm --filter @capsur/admin-web hash-password)
ADMIN_USERS_JSON=[]

# Turnstile (vacío = desactivado)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Correo de confirmación (vacío = desactivado)
SMTP_URL=
MAIL_FROM=

# Chatwoot
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_BASE_URL_ALLOWLIST=chatwoot.example.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_INBOX_ID_BY_CAMPUS={"tacna":1}
CHATWOOT_API_ACCESS_TOKEN=ejemplo-cambiar-chatwoot
CHATWOOT_WEBHOOK_SECRET=ejemplo-cambiar-webhook
CHATWOOT_WEBHOOK_SECRET_PREVIOUS=
WEBHOOK_IP_ALLOWLIST=
CATALOG_URLS_JSON={}
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=

# Meta Conversions API (vacío = desactivado)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Sentry (vacío = desactivado)
PROMOTIONS_SENTRY_DSN=
LEADS_SENTRY_DSN=
CRM_BRIDGE_SENTRY_DSN=
WEB_SENTRY_DSN=
ADMIN_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
