# leads-service
PORT=3002
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgresql://leads:leads@localhost:5432/leads?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://capsur:capsur@localhost:5672
PROMOTIONS_SERVICE_URL=http://localhost:3001
# Número de WhatsApp de captación SIS (E.164 sin "+"). Verificar antes de producción.
WHATSAPP_NUMBER=51987867402
BRAND_DISPLAY_NAME=Sistemas del Sur
REFERENCE_PREFIX=SIS
# Intervalo del relay de outbox en milisegundos
OUTBOX_POLL_INTERVAL_MS=2000
# Límite de solicitudes por IP y minuto en POST /api/v1/leads
LEADS_RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=http://localhost:3000
# Pimienta para el hash SHA-256 de las IP (nunca se guarda la IP en claro). Cambiar en producción.
IP_HASH_PEPPER=cambia-esta-pimienta-en-produccion
