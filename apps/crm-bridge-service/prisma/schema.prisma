// Esquema de crm-bridge-service. Base de datos propia (crm_bridge).
// Nunca se tocan las tablas de Chatwoot: la integración es solo por API y webhooks.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estado del trabajo de sincronización de un lead con Chatwoot.
enum SyncJobStatus {
  PENDING
  SUCCEEDED
  FAILED
  DEAD
}

/// Resultado de un intento individual contra Chatwoot.
enum AttemptStatus {
  SUCCESS
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
}

/// Estado del seguimiento con plantilla de WhatsApp (A6).
enum FollowupStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

/// Estado del envío del evento `Lead` a Meta Conversions API (A17).
enum MetaCapiStatus {
  SENT
  FAILED
  SKIPPED
}

/// Un trabajo por lead. Guarda el payload de `lead.created.v1` CIFRADO (C8) para poder reprocesar.
model SyncJob {
  leadId           String        @id @map("lead_id")
  eventId          String        @map("event_id")
  reference        String
  /// Columna heredada (texto plano). Solo la leen las filas aún no migradas; nunca se escribe.
  payload          Json?
  /// `lead.created.v1` cifrado con PiiCipher (`v1.<iv>.<tag>.<ct>`). NULL tras anonimizar (C9).
  payloadEncrypted String?       @map("payload_encrypted")
  status           SyncJobStatus @default(PENDING)
  attempts         Int           @default(0)
  lastError        String?       @map("last_error")
  anonymizedAt     DateTime?     @map("anonymized_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([status, updatedAt])
  @@index([updatedAt(sort: Desc)])
  @@map("sync_jobs")
}

/// Vínculo entre un lead y su contacto/conversación en Chatwoot.
model CrmContactLink {
  id                   String    @id @default(uuid()) @db.Uuid
  leadId               String    @unique @map("lead_id")
  reference            String    @unique
  crmAccountId         String    @map("crm_account_id")
  crmContactId         String    @map("crm_contact_id")
  crmConversationId    String?   @map("crm_conversation_id")
  crmInboxId           String?   @map("crm_inbox_id")
  assignedTo           String?   @map("assigned_to")
  /// Nombre visible del asesor asignado (A9); null si se asignó a un equipo.
  assignedToName       String?   @map("assigned_to_name")
  labels               String[]  @default([])
  syncedAt             DateTime  @map("synced_at")
  conversationLinkedAt DateTime? @map("conversation_linked_at")
  /// Marca atómica de la respuesta automática (A8): una sola vez por conversación.
  autoReplySentAt      DateTime? @map("auto_reply_sent_at")
  anonymizedAt         DateTime? @map("anonymized_at")

  @@index([crmContactId, syncedAt(sort: Desc)])
  @@index([syncedAt(sort: Desc)])
  @@map("crm_contact_links")
}

/// Bitácora de cada llamada relevante a Chatwoot (auditoría y diagnóstico).
model IntegrationAttempt {
  id         String        @id @default(uuid()) @db.Uuid
  leadId     String        @map("lead_id")
  eventId    String        @map("event_id")
  attempt    Int
  /// sync_contact | link_conversation | assign | auto_reply | followup | feedback | delete_contact
  operation  String
  status     AttemptStatus
  httpStatus Int?          @map("http_status")
  error      String?
  startedAt  DateTime      @map("started_at")
  finishedAt DateTime      @map("finished_at")

  @@index([leadId])
  @@map("integration_attempts")
}

/// Idempotencia de consumo: id del sobre del evento ya procesado.
model ProcessedEvent {
  id          String   @id
  name        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}

/// Webhooks recibidos de Chatwoot (solo los que superan la verificación de autenticidad).
model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  dedupeKey      String    @unique @map("dedupe_key")
  eventType      String    @map("event_type")
  conversationId String?   @map("conversation_id")
  contactId      String?   @map("contact_id")
  payload        Json
  signatureValid Boolean   @map("signature_valid")
  receivedAt     DateTime  @default(now()) @map("received_at")
  processedAt    DateTime? @map("processed_at")
  /// linked | ignored | unmatched | error
  outcome        String?

  @@index([contactId])
  @@index([conversationId])
  @@map("webhook_events")
}

/// Seguimiento con plantilla aprobada de WhatsApp (A6). Uno por lead como máximo.
model WhatsappFollowup {
  leadId            String         @id @map("lead_id")
  status            FollowupStatus @default(PENDING)
  dueAt             DateTime       @map("due_at")
  attempts          Int            @default(0)
  /// Arrendamiento del candado: una réplica caída libera la fila al vencer.
  lockedUntil       DateTime?      @map("locked_until")
  crmConversationId String?        @map("crm_conversation_id")
  templateName      String?        @map("template_name")
  /// Motivo de SKIPPED o error de FAILED (sin datos personales).
  lastError         String?        @map("last_error")
  sentAt            DateTime?      @map("sent_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@index([status, dueAt])
  @@index([crmConversationId])
  @@map("whatsapp_followups")
}

/// Envíos a Meta Conversions API (A17): idempotencia por lead y resultado.
model MetaCapiEvent {
  leadId    String         @id @map("lead_id")
  eventId   String         @map("event_id")
  status    MetaCapiStatus
  attempts  Int            @default(0)
  fbtraceId String?        @map("fbtrace_id")
  lastError String?        @map("last_error")
  sentAt    DateTime?      @map("sent_at")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("meta_capi_events")
}

/// Auditoría de acciones internas (C24). Nunca guarda datos personales en claro.
model AuditLog {
  id       String  @id @db.Uuid
  at       DateTime
  caller   String
  actor    String?
  action   String
  target   String?
  metadata Json?

  @@index([at(sort: Desc)])
  @@map("audit_log")
}
