# promotions-service: variables de entorno (desarrollo)
# Generado por capsur-env-example desde dist/config/env.definition.js#envDefinition. No editar a mano:
# cambia los ejemplos en el esquema del servicio y vuelve a generarlo.

NODE_ENV=development

PORT=3001

LOG_LEVEL=debug

DATABASE_URL=postgresql://promotions:promotions@localhost:5432/promotions?schema=public

REDIS_URL=redis://localhost:6379

# Segundos de caché en Redis de las respuestas públicas del catálogo
CATALOG_CACHE_TTL_SECONDS=60

CORS_ORIGINS=http://localhost:3000

# Llamadores internos permitidos: JSON {"<llamador>":"<token>"}
INTERNAL_API_TOKENS={"admin-web":"dev-admin-to-promotions","leads-service":"dev-leads-to-promotions"}

# Swagger en producción (además exige token interno)
SWAGGER_ENABLED=false

# Vacío = Sentry desactivado
SENTRY_DSN=

# Endpoint de la landing que invalida la caché del catálogo tras un cambio (B8)
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate

# Secreto compartido con la landing (cabecera x-revalidate-secret)
WEB_REVALIDATE_SECRET=dev-revalidate-secret
