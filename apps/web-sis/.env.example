# web-sis (Next.js)
# URLs internas de los servicios (las usa el servidor Next y las reescrituras de desarrollo)
PROMOTIONS_SERVICE_URL=http://localhost:3001
LEADS_SERVICE_URL=http://localhost:3002

# Secreto que promotions-service envía en x-revalidate-secret a POST /api/revalidate (B8).
# Debe coincidir con WEB_REVALIDATE_SECRET de promotions-service. Cambiar en producción.
REVALIDATE_SECRET=dev-revalidate-secret

# Variables públicas (se incrustan en el navegador en el build)
# Base de la API para el navegador. Vacío = mismo origen (recomendado detrás del gateway).
NEXT_PUBLIC_API_BASE_URL=
# WhatsApp de captación SIS en E.164 sin "+". Verificar antes de producción.
NEXT_PUBLIC_WHATSAPP_NUMBER=51987867402
NEXT_PUBLIC_PRIVACY_POLICY_VERSION=2026-11
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Casilla opcional de autorización publicitaria (0/1) y enlaces de redes
NEXT_PUBLIC_SHOW_MARKETING_CONSENT=0
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/ISTPSistemasDelSur
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/istp_sistemasdelsur/
NEXT_PUBLIC_SOCIAL_TIKTOK=https://www.tiktok.com/@istp.sistemasdelsur
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/istp-sistemas-del-sur-81bb81355
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@institutosis6394
# Cloudflare Turnstile (C3). Vacío = sin widget. La clave secreta va en leads-service (TURNSTILE_SECRET_KEY).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Sentry (C23). Vacío = desactivado. Sin PII y sin subida de sourcemaps.
NEXT_PUBLIC_SENTRY_DSN=
# Experimentos A/B (A18): true/false
NEXT_PUBLIC_EXPERIMENTS_ENABLED=true
