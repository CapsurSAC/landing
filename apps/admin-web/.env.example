# admin-web (Next.js) — panel interno CAPSUR. Puerto 3004.
# Copia a .env para desarrollo. NUNCA reutilices estos valores en producción.

# --- Sesión -------------------------------------------------------------------
# Secreto HS256 de la cookie de sesión (mínimo 32 caracteres). Genera uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=dev-only-U5sl4w14P-MLUIvhYU46PsjpZhytaAqc5zDWE8ISb9yttJEoSGP50RgZ
# Cookie Secure + prefijo __Host-: por defecto solo con NODE_ENV=production.
# Fuerza el valor con true/false (p. ej. false si sirves `next start` por http fuera de localhost).
ADMIN_COOKIE_SECURE=

# --- Usuarios -----------------------------------------------------------------
# JSON en UNA línea: [{ "email", "name", "role": "admin" | "asesor", "passwordHash" }]
# Hash con: pnpm --filter @capsur/admin-web hash-password "<clave>"
# Next.js expande "$" en los .env: escribe cada "$" del hash bcrypt como "\$" (y entre comillas simples).
# Usuario de ejemplo: admin@capsur.local / cambia-esta-clave-123
ADMIN_USERS_JSON='[{"email":"admin@capsur.local","name":"Administración SIS","role":"admin","passwordHash":"\$2b\$12\$KVwwKNZf0h/r0jE7UkwlBuoKph88h5aS.ul3PfXg0YIoywU8tisAe"}]'

# --- Servicios internos (solo los usa el servidor del panel) -------------------
ADMIN_BRAND=sis
PROMOTIONS_SERVICE_URL=http://localhost:3001
LEADS_SERVICE_URL=http://localhost:3002
CRM_BRIDGE_SERVICE_URL=http://localhost:3003
# Tokens de llamador "admin-web" en INTERNAL_API_TOKENS de cada servicio.
PROMOTIONS_SERVICE_TOKEN=dev-admin-to-promotions
LEADS_SERVICE_TOKEN=dev-admin-to-leads
CRM_BRIDGE_SERVICE_TOKEN=dev-admin-to-crm
# Tiempo máximo de espera por llamada (ms).
SERVICE_TIMEOUT_MS=8000

# --- Enlaces a Chatwoot en el detalle del lead (opcional) ---------------------
# p. ej. https://chatwoot.example.com y el id numérico de la cuenta.
CHATWOOT_APP_URL=
CHATWOOT_ACCOUNT_ID=

# --- Observabilidad (opcional) -------------------------------------------------
# Vacío = Sentry desactivado. Solo servidor y sin datos personales.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
