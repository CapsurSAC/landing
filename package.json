{
  "name": "capsur-lead-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de captación educativa de GRUPO CAPSUR. Primera implementación: landing IEST Privado Sistemas del Sur (SIS).",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "test:e2e": "turbo run test:e2e",
    "openapi:export": "turbo run openapi:export",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml up -d postgres redis rabbitmq",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml logs -f",
    "infra:config": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml --profile apps config -q",
    "infra:prod:config": "docker compose --env-file infrastructure/docker/prod.env.example -f infrastructure/docker/docker-compose.prod.yml config -q",
    "rabbitmq:apply": "node infrastructure/rabbitmq/apply-definitions.mjs",
    "stack:up": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml --profile apps up -d --build",
    "stack:migrate": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml --profile apps up --build promotions-migrate leads-migrate crm-bridge-migrate",
    "stack:down": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml --profile apps down",
    "load:leads": "docker run --rm -i -e BASE_URL -e RATE -e DURATION -e PROMOTION_ID grafana/k6:1.4.2 run - < infrastructure/load/k6-leads.js",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun --config=.lighthouserc.json",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "changeset version",
    "changeset:tag": "changeset tag",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\""
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "5.9.3"
  },
  "dependencies": {}
}
