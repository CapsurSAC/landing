# ─────────────────────────────────────────────────────────────
#  Configuración del formulario — CAPSUR
#
#  Local: copia como .env en la raíz del proyecto.
#  cPanel: copia como config/.env fuera de public_html.
#  NUNCA subas el .env a Git ni lo dejes dentro de public_html.
# ─────────────────────────────────────────────────────────────

# ── Servidor SMTP ────────────────────────────────────────────
# Brevo:   smtp-relay.brevo.com   puerto 587
# Mailjet: in-v3.mailjet.com      puerto 587
# cPanel:  mail.tudominio.com     puerto 465
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Remitente ────────────────────────────────────────────────
# Debe ser una dirección de TU dominio, con SPF y DKIM configurados.
MAIL_FROM=no-reply@tudominio.com
MAIL_FROM_NOMBRE=Formulario web CAPSUR

# ── Destinatarios ────────────────────────────────────────────
# Uno o varios separados por coma.
MAIL_TO=informes@tudominio.com

# ── Seguridad ────────────────────────────────────────────────
# Dominios desde los que se acepta el formulario (separados por coma).
# Déjalo vacío para no comprobar el origen.
ORIGENES_PERMITIDOS=https://tudominio.com,https://www.tudominio.com

# Máximo de envíos por IP dentro de la ventana (en segundos).
LIMITE_ENVIOS=5
LIMITE_VENTANA=900

# IP del visitante: se toma de la conexión. Las cabeceras X-Forwarded-For y
# CF-Connecting-IP solo se creen si llegan desde Cloudflare o desde un proxy
# de red privada (Docker/EasyPanel), que ya se reconocen solos.
# Rellénalo únicamente si delante hay un proxy propio con IP PÚBLICA: su IP
# o rango CIDR, separados por coma. Si no, todos los visitantes compartirían
# el mismo límite.
PROXIES_CONFIANZA=

# ── Chatwoot ─────────────────────────────────────────────────
# Cada solicitud se registra como conversación en la bandeja API
# "CAPSUR - Formulario web". Con CHATWOOT_TOKEN vacío no se llama a
# Chatwoot y todo sigue igual: CSV y correo.
# URL de Chatwoot, sin barra final.
CHATWOOT_URL=
# Número de la cuenta: el que sale en la URL, /app/accounts/1/...
CHATWOOT_ACCOUNT_ID=
# Token de acceso del usuario "Integración formulario" (Perfil → Token
# de acceso). Es un secreto: solo aquí, nunca en una variable VITE_.
CHATWOOT_TOKEN=
# Id de la bandeja API "CAPSUR - Formulario web".
CHATWOOT_INBOX_ID=
# inmediata: el lead se asigna a un asesor al llegar, por porcentaje.
# diferida:  entra sin asesor y con la etiqueta por_asignar.
CHATWOOT_ASIGNACION=inmediata
# Solo Docker: clave que n8n manda a api/reintentar.php cada 15 minutos
# en la cabecera X-Reintento-Token. Larga y al azar (16 caracteres o
# más); vacía = api/reintentar.php responde 404 a todo.
# Con cron (cPanel) no se usa: ver config/reintentar-chatwoot.php.
REINTENTO_TOKEN=

# ── Panel de leads (public_html/admin/) ──────────────────────
# Usuario con el que se entra al panel (un correo sirve bien).
ADMIN_USUARIO=
# Hash de la contraseña, NUNCA la contraseña. Genéralo con:
#   php config/generar-hash.php "una frase larga y propia"
# y pega aquí la línea completa que imprime.
ADMIN_HASH=

