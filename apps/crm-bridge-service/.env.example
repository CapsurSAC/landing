# crm-bridge-service: variables de entorno (desarrollo). Generado con `pnpm env:example`.
# Generado por capsur-env-example desde dist/config/env.definition.js#envDefinition. No editar a mano:
# cambia los ejemplos en el esquema del servicio y vuelve a generarlo.

# development | test | production
NODE_ENV=development

# Puerto HTTP
PORT=3003

# Nivel de pino
LOG_LEVEL=debug

# Postgres propio (crm_bridge)
DATABASE_URL=postgresql://crm_bridge:crm_bridge@localhost:5432/crm_bridge?schema=public

# Usuario propio del servicio (C21): solo checkQueue, sin permiso configure
RABBITMQ_URL=amqp://crm_bridge_svc:crm_bridge_svc_local@localhost:5672

# Llamadores de /internal/*: JSON {"<llamador>":"<token>"} (C4)
INTERNAL_API_TOKENS={"admin-web":"dev-admin-to-crm","ops":"dev-ops-to-crm"}

# Swagger en producción (exige token igualmente)
SWAGGER_ENABLED=false

# Vacío = Sentry desactivado (C23)
SENTRY_DSN=

# Entorno de Sentry (por defecto NODE_ENV)
SENTRY_ENVIRONMENT=local

# Clave AES-256-GCM (32 bytes en base64) para sync_jobs.payload (C8). Solo desarrollo
PII_ENCRYPTION_KEY=ZGV2LW9ubHktcGlpLWtleS0zMi1ieXRlcy1sb25nISE=

# URL base de Chatwoot (sin /api)
CHATWOOT_BASE_URL=https://chatwoot.example.com

# Hosts permitidos para CHATWOOT_BASE_URL (C20): host, host:puerto o *.dominio, separados por comas
CHATWOOT_BASE_URL_ALLOWLIST=chatwoot.example.com

# account_id de la cuenta en Chatwoot
CHATWOOT_ACCOUNT_ID=1

# Bandeja por defecto (si la sede no está en CHATWOOT_INBOX_ID_BY_CAMPUS)
CHATWOOT_INBOX_ID=1

# Bandeja por sede (A4): JSON {"tacna":1,"arequipa":2}
CHATWOOT_INBOX_ID_BY_CAMPUS={"tacna":1}

# Access Token de un agente/administrador de Chatwoot
CHATWOOT_API_ACCESS_TOKEN=change-me

# Secreto del ?token= y del HMAC del webhook
CHATWOOT_WEBHOOK_SECRET=change-me

# Secreto anterior aceptado durante la rotación (C7); vacío = ninguno
CHATWOOT_WEBHOOK_SECRET_PREVIOUS=

# IPs/CIDR (IPv4 e IPv6) permitidos para el webhook, separados por comas; vacío = sin filtro (C7)
WEBHOOK_IP_ALLOWLIST=

# Equipo por defecto si ninguna regla coincide
CHATWOOT_DEFAULT_TEAM_ID=

# Reglas de asignación (JSON, ver README)
ASSIGNMENT_RULES_JSON=

# round_robin | least_loaded (A9)
ASSIGNMENT_STRATEGY=round_robin

# Respuesta automática al vincular la conversación (A8)
CHATWOOT_AUTO_REPLY_ENABLED=false

# Catálogo PDF por promoción: JSON {"<promotionId>":"https://..."}
CATALOG_URLS_JSON={}

# Seguimiento con plantilla aprobada si no escribió (A6)
WHATSAPP_FOLLOWUP_ENABLED=false

# Nombre de la plantilla aprobada en Meta (categoría UTILITY)
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=

# Idioma de la plantilla (código de Meta, p. ej. es o es_PE)
WHATSAPP_FOLLOWUP_TEMPLATE_LANGUAGE=es

# Horas tras la sincronización sin conversación antes de enviar la plantilla
WHATSAPP_FOLLOWUP_AFTER_HOURS=24

# Pixel/dataset de Meta (A17); vacío = Conversions API desactivada
META_PIXEL_ID=

# Token de sistema para Conversions API; vacío = desactivada
META_CAPI_ACCESS_TOKEN=

# Código de prueba del Administrador de eventos (solo pruebas)
META_CAPI_TEST_EVENT_CODE=

# Base de la Graph API (por defecto https://graph.facebook.com/v21.0; solo cambiar en pruebas)
META_GRAPH_BASE_URL=

# Intentos antes de DEAD y DLQ
MAX_SYNC_ATTEMPTS=5
