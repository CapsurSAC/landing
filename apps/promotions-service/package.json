{
  "name": "@capsur/promotions-service",
  "version": "0.1.0",
  "private": true,
  "description": "Catálogo comercial: marcas, especialidades, promociones, precios y vigencias. Autoridad sobre precios.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test:int": "jest -c jest.int.config.cjs",
    "openapi:export": "nest build && node dist/openapi-export.js",
    "env:example": "capsur-env-example dist/config/env.definition.js envDefinition --out .env.example"
  },
  "dependencies": {
    "@capsur/api-contracts": "workspace:*",
    "@capsur/config": "workspace:*",
    "@capsur/nest-kit": "workspace:*",
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@prisma/client": "6.19.3",
    "@sentry/nestjs": "11.12.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capsur/eslint-config": "workspace:*",
    "@capsur/tsconfig": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.10",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.0",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
